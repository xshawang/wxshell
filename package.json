{
  "name": "node-xshell",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js 终端客户端：SSH / Telnet / 本地 Shell / 裸 TCP",
  "main": "dist/main/index.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:core": "tsc -p tsconfig.build.json",
    "build:renderer": "esbuild src/renderer/index.ts src/renderer/index.html --bundle --outdir=dist/renderer --platform=browser --format=iife --loader:.html=copy --sourcemap",
    "build": "npm run build:core && npm run build:renderer",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && electron scripts/smoke.js",
    "dist": "npm run build && node scripts/package.mjs",
    "dist:dir": "npm run build && node scripts/package.mjs --dir",
    "start": "npm run build && electron .",
    "dev": "npm run build:renderer && electron ."
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "socks": "^2.8.10",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ssh2": "^1.15.1",
    "@types/ws": "^8.5.13",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "node-gyp": "^11.5.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
